{
  "version": 2,
  "builds": [
    {
      "src": "./index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/",
      "methods": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"]
    }
  ],
  "crons": [
    {
      "path": "/api/v1/payment/schedule-cron",
      "schedule": "30 18 * * *"
    },
    {
      "path": "/api/v1/site/cron/hero-sweep",
      "schedule": "15 21 * * *"
    },
    {
      "path": "/api/v1/calendarSync/cron/sweep?mode=full",
      "schedule": "45 0 * * *"
    },
    {
      "path": "/api/v1/booking/cron/notify-sweep",
      "schedule": "30 5 * * *"
    }
  ]
}
