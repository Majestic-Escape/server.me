{
  "version": 2,
  "builds": [
    {
      "src": "./index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/",
      "methods": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"]
    }
  ],
  "crons": [
    {
      "path": "/api/v1/payment/schedule-cron",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron-run",
      "schedule": "* * * * *"
    }
  ]
}
